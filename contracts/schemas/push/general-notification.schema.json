{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aino.local/contracts/push/general-notification.schema.json",
  "title": "General notification push data",
  "description": "link is a relative web path (\"/tasks?task=1\", \"/manager?tab=approvals&request=5\", \"/attendance#leaves\", \"/attendance#manual-entry\", \"/notes?pageId=x\", \"/admin?tab=agile\") or \"\" when the alert has no destination. linkTaskId is the related task id or \"\". Both keys are sent only to device tokens registered with pushVersion 2 (Android 0.15.0+); older apps validate an exact key set and receive neither.",
  "type": "object",
  "required": ["notificationId", "type", "title", "body", "badgeCount", "dedupeKey", "actorAvatar", "actorName", "tenantId", "sentAt"],
  "properties": {
    "notificationId": { "$ref": "#/$defs/positiveIntegerString" },
    "type": { "type": "string", "minLength": 1, "not": { "enum": ["incoming_call", "call_handled_elsewhere", "chat_message"] } },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "badgeCount": { "$ref": "#/$defs/positiveIntegerString" },
    "dedupeKey": { "type": "string", "pattern": "^notif:[1-9][0-9]*$" },
    "actorAvatar": { "type": "string" },
    "actorName": { "type": "string" },
    "link": { "type": "string", "pattern": "^(|/(?!/).*)$" },
    "linkTaskId": { "type": "string", "pattern": "^(|[1-9][0-9]*)$" },
    "tenantId": { "type": "string", "pattern": "^(|[1-9][0-9]*)$" },
    "sentAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": { "positiveIntegerString": { "type": "string", "pattern": "^[1-9][0-9]*$" } }
}