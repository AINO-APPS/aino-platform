  "non_goals": [
    {
      "id": "watchers",
      "rationale": "No watcher or subscription model exists server-side; notification scope is fixed by D49."
    },
    {
      "id": "versions-releases",
      "rationale": "No release entity exists; sprints carry delivery cadence."
    },
    {
      "id": "roadmap-gantt",
      "rationale": "Requires a cross-sprint timeline model; Schedule covers day-level planning per D22."
    },
    {
      "id": "workload-resource-view",
      "rationale": "Needs a capacity model, deferred by D33."
    },
    {
      "id": "capacity-planning",
      "rationale": "Deferred by D33; story points plus historical velocity cover planning in v1."
    },
    {
      "id": "swimlanes",
      "rationale": "Doubles board interaction complexity with no demand evidence; grouping is a later view option per D20."
    },
    {
      "id": "subtask-checklist-ui",
      "rationale": "parent_task_id exists and subtasks render, but an inline checklist UI is deferred."
    },
    {
      "id": "shared-saved-views",
      "rationale": "Personal views ship first; org-shared views are v2."
    },
    {
      "id": "mobile-offline-write",
      "rationale": "No offline write queue exists in any client; realtime field deltas require connectivity per D48."
    },
    {
      "id": "planner-buckets",
      "rationale": "Buckets would become a second container competing with sprints; flat ranked list chosen per D20."
    },
    {
      "id": "board-bulk-actions",
      "rationale": "Bulk triage belongs in backlog; board bulk would double drag-and-drop complexity per D23."
    },
    {
      "id": "service-desk-changes",
      "rationale": "Unrelated to backlog, sprint and schedule; explicitly untouched per D31."
    }
  ]
}
