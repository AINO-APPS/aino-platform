          "sprints"
        ],
        "summary": "Read a sprint board with column WIP status",
        "operationId": "get_api_sprints_id_board",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
