{
  "schemas": {
    "SearchTask": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_state_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": "string"
        },
        "planned_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "sprint_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "container": {
          "type": "string",
          "enum": [
            "sprint",
            "scheduled",
            "backlog"
          ]
        },
        "capabilities": {
          "$ref": "#/components/schemas/TicketCapabilities"
        },
        "snippet": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "priority",
        "planned_date",
        "due_date",
        "sprint_id",
        "container",
        "capabilities",
        "snippet"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "issue_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Canonical PROJ-123 reference. Stable across sprint moves."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "workflow_state_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "workflow_state_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_state_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_state_category": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "open",
            "in_progress",
            "in_review",
            "done",
            null
          ]
        },
        "planned_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date-only planning metadata. Never affects backlog membership."
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Derived by the database from the workflow-state category. Clients never write it."
        },
        "sprint_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "container": {
          "type": "string",
          "enum": [
            "sprint",
            "scheduled",
            "backlog"
          ]
        },
        "capabilities": {
          "$ref": "#/components/schemas/TicketCapabilities"
        },
        "team_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rank": {
          "type": [
            "string",
            "null"
          ],
          "description": "LexoRank string, unique per team."
        },
        "parent_task_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "work_item_type_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "story_points": {
          "type": [
            "number",
            "null"
          ]
        },
        "estimated_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Planned effort in minutes. Shown against logged_minutes."
        },
        "logged_minutes": {
          "type": "integer",
          "minimum": 0,
          "description": "Minutes logged by timers started from this task. Rolls into the timesheet."
        },
        "assigned_to": {
          "type": [
            "integer",
            "null"
          ]
        },
        "user_id": {
          "type": "integer"
        },
        "org_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "is_blocked": {
          "type": "boolean"
        },
        "blocked_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_criteria": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "priority",
        "workflow_state_id",
        "planned_date",
        "due_date",
        "completed_at",
        "sprint_id",
        "container",
        "capabilities",
        "team_id",
        "rank",
        "is_blocked"
      ],
      "additionalProperties": false
    },
