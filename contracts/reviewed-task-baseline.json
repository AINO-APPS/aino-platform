              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SprintBoard"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sprint id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or session invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
